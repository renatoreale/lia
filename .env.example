# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role secret — server-only, never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — used for embeddings, RAG answer generation and email
# classification/drafting (wired starting Phase 2)
OPENAI_API_KEY=

# Gmail API (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph (Phase 3)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
