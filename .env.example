# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role secret — server-only, never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — used for embeddings, RAG answer generation and email
# classification/drafting (wired starting Phase 2)
OPENAI_API_KEY=

# Fixed origin (no trailing slash) used to build the Gmail/Outlook OAuth
# redirect_uri, e.g. https://lia-beta-five.vercel.app. Must exactly match
# what's registered in Google Cloud Console / Azure AD. Vercel gives every
# deployment its own unique URL in addition to the stable one -- without
# this, opening a per-deployment URL instead of the stable one breaks
# OAuth with a redirect_uri_mismatch. Leave unset for local dev (falls
# back to the request's own origin, e.g. http://localhost:3001).
APP_URL=

# Gmail API (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph (Phase 3)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# AES-256 key (32 bytes, base64) used to encrypt integrations.access_token /
# refresh_token before they're stored. Generate with: openssl rand -base64 32
# Must also be set as a Supabase Edge Function secret (same value) -- see
# README for `supabase secrets set`.
TOKEN_ENCRYPTION_KEY=

# Shared secret checked on the /api/cron/sync-emails route (Vercel Cron
# calls it with this value in the Authorization header). Generate with:
# openssl rand -base64 32
CRON_SECRET=
